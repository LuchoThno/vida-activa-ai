NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Never expose a Supabase service_role key to the browser.

# --- Opcionales ---
# Voz natural con IA y traducción de alta calidad (OpenAI). Sin esta clave, la app usa
# la mejor voz en español del dispositivo y el traductor gratuito MyMemory.
# OPENAI_API_KEY=sk-...
# OPENAI_TTS_VOICE=nova
# Amplía la cuota gratuita diaria del traductor MyMemory (5.000 → 50.000 caracteres).
# MYMEMORY_EMAIL=tu-correo@ejemplo.cl
# Videos en español dentro de la app para cualquier ejercicio (YouTube Data API v3).
# YOUTUBE_API_KEY=AIza...
